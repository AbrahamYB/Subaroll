{
  "name": "subaroll",
  "version": "1.3.0",
  "description": "Native Rust/Tauri IINA/libass-style subtitle burn-in tool",
  "author": "Local project",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/run-tauri.js dev",
    "test": "node scripts/run-cargo.js test --manifest-path src-tauri/Cargo.toml",
    "build:mac": "node scripts/run-tauri.js build --bundles app",
    "build:win": "node scripts/run-tauri.js build --bundles nsis",
    "prepare:ffmpeg:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-windows-ffmpeg.ps1",
    "update:installed:mac": "./scripts/update-installed-mac.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.3"
  }
}
