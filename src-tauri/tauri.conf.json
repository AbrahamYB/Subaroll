{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Subtitle Burner",
  "mainBinaryName": "Subtitle Burner",
  "version": "1.1.0",
  "identifier": "local.subtitleburner.app",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Subtitle Burner",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "backgroundColor": "#111218",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": [
      "../assets/icon.icns",
      "../assets/icon.ico",
      "../assets/icon.png"
    ],
    "category": "Video",
    "shortDescription": "Burn subtitles and compress videos",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    }
  }
}
