{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Subaroll",
  "mainBinaryName": "Subaroll",
  "version": "1.3.1",
  "identifier": "local.subtitleburner.app",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Subaroll",
        "width": 880,
        "height": 764,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "backgroundColor": "#101114",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "nsis"
    ],
    "icon": [
      "../assets/icon.icns",
      "../assets/icon.ico",
      "../assets/icon.png"
    ],
    "category": "Video",
    "shortDescription": "Burn subtitles and compress videos",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4NTNDQjEzQzE0QjREMEQKUldRTlRVdkJFOHRUbUswWmFvenFwY251eXpXZ29YVStzcm40TXNnSVhVakxmMWFqem9raVJhMlkK",
      "endpoints": [
        "https://github.com/AbrahamYB/Subaroll/releases/latest/download/latest.json?from={{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
